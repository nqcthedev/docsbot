{
  "name": "docsbot",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant RAG chatbot SaaS: train a support bot on your website, PDFs and FAQs, embed it anywhere.",
  "license": "MIT",
  "author": "Cuong Nguyen",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm build:widget && next dev --port 3100",
    "build": "pnpm build:widget && next build",
    "start": "next start --port 3100",
    "build:widget": "node scripts/build-widget.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "fixture": "tsx scripts/fixture-server.ts",
    "seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "fixture:pdf": "node scripts/make-fixture-pdf.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-pgvector": "^0.0.18",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "domhandler": "^6.0.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "lucide-react": "^1.76.0",
    "next": "15.5.29",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "undici": "^8.12.4",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
