# ---------------------------------------------------------------------------
# DocsBot configuration. Copy to .env and fill in at least one AI provider key.
# Every variable is validated at startup (src/server/env.ts).
# ---------------------------------------------------------------------------

# Public URL of this app (used in the embed snippet and cookies). No trailing slash.
APP_URL=http://localhost:3100

# Database.
#   Local dev / tests: embedded Postgres (PGlite + pgvector), zero setup:
DATABASE_URL=pglite://.data/pglite
#   Production: any Postgres 15+ with the pgvector extension (Neon, Supabase, self-hosted):
# DATABASE_URL=postgres://user:password@host:5432/docsbot?sslmode=require
# Supabase/Neon transaction poolers (pgbouncer) need prepared statements off:
# DATABASE_PREPARE=false
# DATABASE_POOL_SIZE=10
# Run migrations automatically on first connection (PGlite only; use `pnpm db:migrate` for Postgres).
DB_AUTO_MIGRATE=true

# --- AI providers (configure one or more) ----------------------------------
# Google Gemini through its OpenAI-compatible endpoint.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1/   # or any OpenAI-compatible gateway
ANTHROPIC_API_KEY=

# Default model for new bots, and the fallback chain tried when a provider fails
# (429, 5xx, timeouts). Models whose provider has no key are skipped automatically.
DEFAULT_CHAT_MODEL=gemini-2.5-flash
CHAT_FALLBACK_MODELS=gemini-3.5-flash-lite,gpt-4o-mini,claude-haiku-5-5

# Embeddings: "gemini" (gemini-embedding-001) or "openai" (text-embedding-3-small).
# Defaults to gemini when GEMINI_API_KEY is set. Vectors are always 1536-dimensional.
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001

AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# --- Ingestion --------------------------------------------------------------
# NEVER enable in production: allows crawling localhost/private IPs (SSRF).
CRAWLER_ALLOW_PRIVATE_NETWORKS=false
CRAWLER_MAX_PAGES=100
CRAWLER_TIMEOUT_MS=10000
MAX_UPLOAD_MB=10
# inline = process the ingestion queue inside the web server (Node / Docker).
# off    = only via POST /api/cron/ingest (e.g. Vercel Cron) with CRON_SECRET.
INGEST_WORKER=inline
CRON_SECRET=

# --- Abuse protection -------------------------------------------------------
RATE_LIMIT_CHAT_PER_IP_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_BOT_PER_HOUR=600
MAX_MESSAGE_CHARS=2000
# Trust X-Forwarded-For for client IPs (true behind Vercel / a reverse proxy you control).
TRUST_PROXY=true

LOG_LEVEL=info
